# ---------------------------------------------------------------------------
# Variables de despliegue de Gestion de Panaderia.
# ---------------------------------------------------------------------------
#
# NINGUN valor de este archivo es real. Copiar a `.env` y reemplazar TODO.
#
#   cp .env.example .env
#
# Para generar `APP_KEY`:
#
#   docker compose -f docker-compose.prod.yml run --rm api php artisan key:generate --show
#
# Ver docs/04-INSTALACION.md.
# ---------------------------------------------------------------------------

# --- Direcciones -----------------------------------------------------------
# Son las URLs PUBLICAS: las que las personas usan.

# URL de la API.
APP_URL=https://api.panaderia.ejemplo.cl

# URL de la interfaz. Es la que se usa para los enlaces y para redirigir al
# proveedor de identidad.
APP_WEB_URL=https://panaderia.ejemplo.cl

# --- Secretos --------------------------------------------------------------
# Los tres son OBLIGATORIOS. El `docker-compose.prod.yml` se niega a arrancar
# si falta alguno: `?` en la variable lo hace explicito.

# Clave de la aplicacion. Se genera con el comando de arriba.
APP_KEY=cambiar-generar-con-key-generate-show

# Contrasena de la base de datos.
DB_PASSWORD=cambiar-esta-contrasena

# Contrasena de Redis. Sin esto, Redis acepta cualquier conexion.
REDIS_PASSWORD=cambiar-esta-contrasena

# --- Proveedor de identidad -------------------------------------------------
# Authentik. El issuer debe terminar en barra.

AUTHENTIK_ISSUER=https://id.ejemplo.cl/application/o/panaderia/
AUTHENTIK_CLIENT_ID=cambiar-por-el-id-real
AUTHENTIK_CLIENT_SECRET=cambiar-por-el-secreto-real
AUTHENTIK_REDIRECT_URI=https://api.panaderia.ejemplo.cl/api/v1/acceso/callback

# --- Reglas de la panaderia (opcionales) ----------------------------------
#
# Ver docs/05-CONFIGURACION.md.

# Dias de anticipacion con que se avisa de un lote que esta por vencer.
# Valor por omision: 1. **Pendiente de confirmar con la panaderia.**
# PANADERIA_DIAS_AVISO_CADUCIDAD=1

# Vigencia por omision, en dias, para un producto sin regla propia.
# Se deja VACIO a proposito: un numero inventado seria una regla de negocio
# falsa. Ver docs/05.
# PANADERIA_VIGENCIA_POR_DEFECTO_DIAS=

# Minutos que puede esperar una venta antes de que se avise.
# **Pendiente de confirmar con la panaderia.**
# PANADERIA_MINUTOS_MAXIMOS_VENTA=10