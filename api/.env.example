# ---------------------------------------------------------------------------
# Variables de entorno de la API de Gestion de Panaderia
# ---------------------------------------------------------------------------
#
# NINGUN valor de este archivo es real. Los secretos se generan con:
#
#   php artisan key:generate --show
#
# Las variables `PANADERIA_*` son opcionales: si no se definen, se usan los
# valores por omision de `config/panaderia.php`.
# ---------------------------------------------------------------------------

APP_NAME="Panadería Hefesto"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_WEB_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------------
# El rol de esta conexion NO puede ser superusuario ni tener BYPASSRLS.
# Con cualquiera de las dos, PostgreSQL ignora las politicas de Row Level
# Security y una panaderia podria ver los datos de otra. Lo comprueba:
#   php artisan panaderia:verificar-aislamiento
DB_CONNECTION=pgsql
DB_DATABASE=panaderia
DB_USERNAME=panaderia_app
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Rol de arranque de PostgreSQL
# ---------------------------------------------------------------------------
# El rol de arriba es el de la APLICACION. Este es el de arranque: la imagen
# oficial lo crea como superusuario, asi que la aplicacion NUNCA conecta con el.
# Con superusuario, PostgreSQL ignora las politicas de Row Level Security y una
# empresa podria ver los datos de otra. Los dos detalles, en docs/03.
DB_ADMIN_USERNAME=panaderia_admin
DB_ADMIN_PASSWORD=

DB_HOST=postgres
DB_PORT=5432

# Solo en produccion: Redis exige contrasena.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=false

# ---------------------------------------------------------------------------
# Authentik (proveedor de identidad)
# ---------------------------------------------------------------------------
AUTHENTIK_ISSUER=https://id.ejemplo.cl/application/o/panaderia/
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_REDIRECT_URI=http://localhost:8000/api/v1/acceso/callback
AUTHENTIK_SCOPES=openid profile email
AUTHENTIK_ALGORITMO=RS256
AUTHENTIK_GRUPO_ADMIN=panaderia-administradores
AUTHENTIK_GRUPO_OPERADORES=panaderia-operadores

# ---------------------------------------------------------------------------
# Reglas de la panaderia (opcionales)
# ---------------------------------------------------------------------------

# Vigencia por omision, en dias, para un producto que NO tenga una regla
# propia en la tabla `vigencias`.
#
# OJO: el valor por omision es NULO a proposito. Un numero inventado seria
# una regla de negocio falsa: lo correcto es que el lote quede sin fecha de
# vencimiento y que la panaderia configure la suya. Ver docs/05.
PANADERIA_VIGENCIA_POR_DEFECTO_DIAS=

# Dias de anticipacion con que se avisa de un lote que esta por vencer.
# Es solo una ventana de aviso de la interfaz, no una regla de negocio.
# Valor por omision: 1 dia. **Pendiente de confirmar con la panaderia.**
PANADERIA_DIAS_AVISO_CADUCIDAD=1

# Merma estimada por omision en las recetas, en porcentaje. El valor por
# omision es 0: el sistema no inventa una merma que nadie declaro.
PANADERIA_MERMA_POR_DEFECTO_PORCENTAJE=0

# Minutos que puede esperar una persona en el mostrador antes de que la venta
# se rechace por el tiempo de espera. No bloquea: solo informa.
PANADERIA_MINUTOS_MAXIMOS_VENTA=10

# Poner en "true" solo en desarrollo: el entrypoint corre las migraciones
# automaticamente. En produccion se aplican a mano, una vez.
PANADERIA_CORRER_MIGRACIONES=false